{
  "cli": {
    "version": ">= 16.25.1",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "channel": "development"
    },
    "development": {
      "autoIncrement": true,
      "environment": "development",
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": "versionCode"
      },
      "ios": {
        "image": "latest",
        "autoIncrement": "buildNumber"
      },
      "channel": "development"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "autoIncrement": "versionCode"
      },
      "ios": {
        "image": "latest",
        "autoIncrement": "buildNumber"
      },
      "channel": "production"
    }
  },
  "submit": {
    "development": {
      "android": {
        "track": "internal",
        "serviceAccountKeyPath": "./google-services.json",
        "releaseStatus": "draft"
      },
      "ios": {
        "appleId": "logicphire@logicphire.com.br",
        "ascAppId": "6754695838"
      }
    },
    "production": {
      "android": {
        "track": "production",
        "serviceAccountKeyPath": "./google-services.json",
        "releaseStatus": "draft"
      },
      "ios": {
        "appleId": "logicphire@logicphire.com.br",
        "ascAppId": "6754695838"
      }
    }
  }
}
