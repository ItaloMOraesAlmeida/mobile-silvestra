{
  "expo": {
    "name": "silvestra",
    "slug": "silvestra-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "silvestra",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.logicphire.silvestra",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Silvestra precisa acessar sua câmera para você tirar fotos do seu perfil e registrar seu progresso nutricional.",
        "NSPhotoLibraryUsageDescription": "Silvestra precisa acessar suas fotos para você escolher imagens do seu perfil e registrar seu progresso nutricional.",
        "NSPhotoLibraryAddUsageDescription": "Silvestra precisa salvar fotos na sua galeria para registrar seu progresso nutricional.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.logicphire.silvestra",
      "adaptiveIcon": {
        "backgroundColor": "#312234",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "f7293a17-ecaa-43a5-8f93-4f66544183e7"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f7293a17-ecaa-43a5-8f93-4f66544183e7"
    }
  }
}
