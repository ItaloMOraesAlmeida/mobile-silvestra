/**
 * Tela de Detalhes do Plano Alimentar
 * Sprint 8-9 - Meal Plans Module
 *
 * Visualização completa do plano com:
 * - Informações gerais (nome, período, status)
 * - Resumo nutricional completo
 * - Lista de todas as refeições e alimentos
 * - Ações: editar, excluir, clonar, gerar lista de compras, compartilhar
 */

import React, { useEffect, useState } from "react";
import {
  View,
  Text,
  TouchableOpacity,
  ScrollView,
  ActivityIndicator,
  Alert,
  Share,
} from "react-native";
import { SafeAreaView } from "react-native-safe-area-context";
import { Ionicons } from "@expo/vector-icons";
import { Paths, File } from "expo-file-system";
import * as Sharing from "expo-sharing";
import { useMealPlansStore } from "../stores/meal-plans.store";
import MacroNutritionCharts from "../components/MacroNutritionCharts";
import {
  getPlanStatusIcon,
  getPlanStatusColor,
  getPlanStatusLabel,
  getMealTypeIcon,
  getMealTypeColor,
  formatGrams,
  formatCalories,
  formatMacro,
  formatPlanPeriod,
  formatShortDate,
  getDaysRemaining,
  getProgressColor,
  getProgressLabel,
  getMacroColor,
  getNutritionSummaryText,
} from "../utils/meal-plan.utils";

interface Props {
  navigation: any;
  route: any;
}

export default function MealPlanDetailsScreen({ navigation, route }: Props) {
  const {
    selectedPlan,
    loadPlanById,
    deletePlan,
    clonePlan,
    exportPlanPdf,
    generateShoppingList,
    loading,
    error,
  } = useMealPlansStore();

  const [expandedMeals, setExpandedMeals] = useState<Set<string>>(new Set());

  const planId = route?.params?.planId || selectedPlan?.id;

  useEffect(() => {
    if (planId) {
      loadPlanById(planId);
    }
  }, [planId, loadPlanById]);

  const toggleMealExpansion = (mealId: string) => {
    setExpandedMeals((prev) => {
      const newSet = new Set(prev);
      if (newSet.has(mealId)) {
        newSet.delete(mealId);
      } else {
        newSet.add(mealId);
      }
      return newSet;
    });
  };

  const handleEdit = async () => {
    if (!selectedPlan) return;

    try {
      // Carregar plano completo no builder para edição
      const { initBuilderForEdit } = useMealPlansStore.getState();
      await initBuilderForEdit(selectedPlan.id);

      // Navegar para o Builder em modo de edição
      navigation.navigate("MealPlanBuilder", {
        mode: "edit",
        planId: selectedPlan.id,
      });
    } catch (err: any) {
      Alert.alert("Erro", err.message || "Erro ao carregar plano para edição");
    }
  };

  const handleDelete = () => {
    if (!selectedPlan) return;

    Alert.alert(
      "Excluir Plano",
      `Tem certeza que deseja excluir o plano "${selectedPlan.name}"? Esta ação não pode ser desfeita.`,
      [
        { text: "Cancelar", style: "cancel" },
        {
          text: "Excluir",
          style: "destructive",
          onPress: async () => {
            try {
              await deletePlan(selectedPlan.id);
              Alert.alert("Sucesso", "Plano excluído com sucesso");
              navigation.goBack();
            } catch (err: any) {
              Alert.alert("Erro", err.message || "Erro ao excluir plano");
            }
          },
        },
      ]
    );
  };

  const handleClone = async () => {
    if (!selectedPlan) return;

    Alert.alert("Duplicar Plano", "Deseja criar uma cópia deste plano?", [
      { text: "Cancelar", style: "cancel" },
      {
        text: "Duplicar",
        onPress: async () => {
          try {
            const clonedPlan = await clonePlan(selectedPlan.id);
            Alert.alert("Sucesso", `Plano duplicado: "${clonedPlan.name}"`, [
              {
                text: "Ver Cópia",
                onPress: () =>
                  navigation.replace("MealPlanDetails", {
                    planId: clonedPlan.id,
                  }),
              },
              { text: "OK" },
            ]);
          } catch (err: any) {
            Alert.alert("Erro", err.message || "Erro ao duplicar plano");
          }
        },
      },
    ]);
  };

  const handleGenerateShoppingList = async () => {
    if (!selectedPlan) return;

    try {
      await generateShoppingList(selectedPlan.id);
      Alert.alert("Sucesso", "Lista de compras gerada!", [
        {
          text: "Ver Lista",
          onPress: () =>
            navigation.navigate("ShoppingList", { planId: selectedPlan.id }),
        },
        { text: "OK" },
      ]);
    } catch (err: any) {
      Alert.alert("Erro", err.message || "Erro ao gerar lista de compras");
    }
  };

  const handleShare = async () => {
    if (!selectedPlan) return;

    const nutritionText = getNutritionSummaryText(selectedPlan.nutrition);
    const mealsText = selectedPlan.meals
      .map((meal) => {
        const items = meal.items
          .map((item) => `  • ${item.name} (${formatGrams(item.quantity)})`)
          .join("\n");
        return `\n${getMealTypeIcon(meal.type)} ${meal.name} - ${
          meal.time || "Sem horário"
        }\n${items}`;
      })
      .join("\n");

    const message = `
📋 Plano Alimentar: ${selectedPlan.name}

📅 Período: ${formatPlanPeriod(selectedPlan.startDate, selectedPlan.endDate)}
📊 Status: ${getPlanStatusLabel(selectedPlan.status)}

🔢 Resumo Nutricional:
${nutritionText}

🍽️ Refeições:${mealsText}

---
Gerado pelo Silvestra App 🌿
    `.trim();

    try {
      await Share.share({
        message,
        title: `Plano Alimentar - ${selectedPlan.name}`,
      });
    } catch (err) {
      console.error("Erro ao compartilhar:", err);
    }
  };

  const handleExportPdf = async () => {
    if (!selectedPlan) return;

    try {
      Alert.alert("Exportando PDF", "Gerando PDF do plano alimentar...");

      // Obter o blob do PDF do backend
      const pdfBlob = await exportPlanPdf(selectedPlan.id);

      // Criar arquivo temporário no diretório de cache
      const fileName = `plano-${selectedPlan.id.substring(0, 8)}.pdf`;
      const file = new File(Paths.cache, fileName);

      // Converter blob para ArrayBuffer e escrever no arquivo
      const arrayBuffer = await (pdfBlob as any).arrayBuffer();
      const uint8Array = new Uint8Array(arrayBuffer);

      // Escrever arquivo usando a nova API
      await file.write(uint8Array);

      // Verificar se compartilhamento está disponível
      const isAvailable = await Sharing.isAvailableAsync();

      if (isAvailable) {
        await Sharing.shareAsync(file.uri, {
          mimeType: "application/pdf",
          dialogTitle: `Plano Alimentar - ${selectedPlan.name}`,
          UTI: "com.adobe.pdf",
        });
      } else {
        Alert.alert("Sucesso", `PDF salvo em: ${file.uri}`, [{ text: "OK" }]);
      }
    } catch (err: any) {
      console.error("Erro ao exportar PDF:", err);
      Alert.alert("Erro", err.message || "Erro ao exportar PDF");
    }
  };

  if (loading && !selectedPlan) {
    return (
      <SafeAreaView className="flex-1 bg-white items-center justify-center">
        <ActivityIndicator size="large" color="#3B82F6" />
        <Text className="text-gray-500 mt-4">Carregando plano...</Text>
      </SafeAreaView>
    );
  }

  if (error || !selectedPlan) {
    return (
      <SafeAreaView className="flex-1 bg-white items-center justify-center px-4">
        <Ionicons name="alert-circle-outline" size={64} color="#EF4444" />
        <Text className="text-red-600 text-lg font-semibold mt-4">
          Erro ao carregar plano
        </Text>
        <Text className="text-gray-500 text-center mt-2">
          {error || "Plano não encontrado"}
        </Text>
        <TouchableOpacity
          onPress={() => navigation.goBack()}
          className="bg-blue-600 px-6 py-3 rounded-xl mt-6"
        >
          <Text className="text-white font-semibold">Voltar</Text>
        </TouchableOpacity>
      </SafeAreaView>
    );
  }

  const plan = selectedPlan;
  const daysRemaining = getDaysRemaining(plan.endDate);

  return (
    <SafeAreaView className="flex-1 bg-white">
      {/* Header */}
      <View className="flex-row items-center justify-between px-4 py-3 border-b border-gray-100">
        <TouchableOpacity onPress={() => navigation.goBack()}>
          <Ionicons name="arrow-back" size={24} color="#111827" />
        </TouchableOpacity>
        <Text className="text-lg font-semibold text-gray-900">
          Detalhes do Plano
        </Text>
        <TouchableOpacity onPress={handleShare}>
          <Ionicons name="share-outline" size={24} color="#3B82F6" />
        </TouchableOpacity>
      </View>

      <ScrollView className="flex-1" refreshControl={undefined}>
        {/* Plan Header Card */}
        <View className="bg-gradient-to-br from-blue-50 to-indigo-50 mx-4 mt-4 p-4 rounded-2xl border border-blue-100">
          <View className="flex-row items-start justify-between mb-3">
            <View className="flex-1">
              <Text className="text-xl font-bold text-gray-900 mb-1">
                {plan.name}
              </Text>
              {plan.description && (
                <Text className="text-sm text-gray-600 mb-2">
                  {plan.description}
                </Text>
              )}
            </View>
            {plan.isTemplate && (
              <View className="bg-amber-100 px-3 py-1 rounded-full">
                <Text className="text-amber-700 text-xs font-medium">
                  📋 Template
                </Text>
              </View>
            )}
          </View>

          {/* Status & Period */}
          <View className="flex-row items-center flex-wrap gap-2 mb-3">
            <View
              className="px-3 py-1 rounded-full"
              style={{
                backgroundColor: getPlanStatusColor(plan.status) + "20",
              }}
            >
              <Text
                className="text-xs font-medium"
                style={{ color: getPlanStatusColor(plan.status) }}
              >
                {getPlanStatusIcon(plan.status)}{" "}
                {getPlanStatusLabel(plan.status)}
              </Text>
            </View>
            <View className="bg-gray-100 px-3 py-1 rounded-full">
              <Text className="text-gray-700 text-xs">
                📅 {formatPlanPeriod(plan.startDate, plan.endDate)}
              </Text>
            </View>
            {daysRemaining !== null && daysRemaining >= 0 && (
              <View className="bg-blue-100 px-3 py-1 rounded-full">
                <Text className="text-blue-700 text-xs font-medium">
                  ⏱️ {daysRemaining} dia(s) restantes
                </Text>
              </View>
            )}
          </View>

          {/* Quick Actions */}
          <View className="flex-row gap-2 mb-2">
            <TouchableOpacity
              onPress={handleEdit}
              className="flex-1 bg-white border border-gray-200 py-2 rounded-lg flex-row items-center justify-center"
            >
              <Ionicons name="create-outline" size={16} color="#3B82F6" />
              <Text className="text-blue-600 text-sm font-medium ml-1">
                Editar
              </Text>
            </TouchableOpacity>
            <TouchableOpacity
              onPress={handleClone}
              className="flex-1 bg-white border border-gray-200 py-2 rounded-lg flex-row items-center justify-center"
            >
              <Ionicons name="copy-outline" size={16} color="#10B981" />
              <Text className="text-green-600 text-sm font-medium ml-1">
                Duplicar
              </Text>
            </TouchableOpacity>
            <TouchableOpacity
              onPress={handleDelete}
              className="flex-1 bg-white border border-gray-200 py-2 rounded-lg flex-row items-center justify-center"
            >
              <Ionicons name="trash-outline" size={16} color="#EF4444" />
              <Text className="text-red-600 text-sm font-medium ml-1">
                Excluir
              </Text>
            </TouchableOpacity>
          </View>

          {/* Export PDF Button - Full Width */}
          <TouchableOpacity
            onPress={handleExportPdf}
            className="bg-purple-600 py-3 rounded-lg flex-row items-center justify-center"
            disabled={loading}
          >
            <Ionicons name="download-outline" size={18} color="#FFFFFF" />
            <Text className="text-white text-sm font-semibold ml-2">
              Exportar PDF
            </Text>
          </TouchableOpacity>
        </View>

        {/* Nutrition Summary */}
        <View className="mx-4 mt-4">
          <Text className="text-base font-semibold text-gray-900 mb-3">
            Resumo Nutricional
          </Text>

          {/* Calories */}
          <View className="bg-white rounded-2xl border border-gray-200 p-4 mb-3">
            <View className="flex-row items-center justify-between mb-2">
              <Text className="text-sm text-gray-600">Calorias Totais</Text>
              <View className="flex-row items-center">
                <Text className="text-xl font-bold text-gray-900">
                  {formatCalories(plan.nutrition.totalCalories)}
                </Text>
                {plan.nutrition.targetCalories && (
                  <Text className="text-sm text-gray-500 ml-2">
                    / {formatCalories(plan.nutrition.targetCalories)}
                  </Text>
                )}
              </View>
            </View>
            {plan.nutrition.targetCalories && (
              <>
                <View className="bg-gray-200 h-2 rounded-full overflow-hidden mb-2">
                  <View
                    className="h-full rounded-full"
                    style={{
                      width: `${Math.min(
                        plan.nutrition.caloriesProgress || 0,
                        100
                      )}%`,
                      backgroundColor: getProgressColor(
                        plan.nutrition.caloriesProgress || 0
                      ),
                    }}
                  />
                </View>
                <Text className="text-xs text-gray-500 text-center">
                  {getProgressLabel(plan.nutrition.caloriesProgress || 0)}
                </Text>
              </>
            )}
          </View>

          {/* Macros Grid */}
          <View className="flex-row flex-wrap gap-3">
            {/* Proteínas */}
            <View className="flex-1 min-w-[45%] bg-white rounded-2xl border border-gray-200 p-4">
              <View className="flex-row items-center mb-2">
                <View
                  className="w-3 h-3 rounded-full mr-2"
                  style={{ backgroundColor: getMacroColor("protein") }}
                />
                <Text className="text-xs text-gray-600">Proteínas</Text>
              </View>
              <Text className="text-2xl font-bold text-gray-900 mb-1">
                {formatMacro(plan.nutrition.totalProtein)}
              </Text>
              <Text className="text-xs text-gray-500">
                {plan.nutrition.proteinPercentage.toFixed(0)}% do total calórico
              </Text>
              {plan.nutrition.targetProtein && (
                <Text className="text-xs text-gray-400 mt-1">
                  Meta: {formatMacro(plan.nutrition.targetProtein)}
                </Text>
              )}
            </View>

            {/* Carboidratos */}
            <View className="flex-1 min-w-[45%] bg-white rounded-2xl border border-gray-200 p-4">
              <View className="flex-row items-center mb-2">
                <View
                  className="w-3 h-3 rounded-full mr-2"
                  style={{ backgroundColor: getMacroColor("carbs") }}
                />
                <Text className="text-xs text-gray-600">Carboidratos</Text>
              </View>
              <Text className="text-2xl font-bold text-gray-900 mb-1">
                {formatMacro(plan.nutrition.totalCarbs)}
              </Text>
              <Text className="text-xs text-gray-500">
                {plan.nutrition.carbsPercentage.toFixed(0)}% do total calórico
              </Text>
              {plan.nutrition.targetCarbs && (
                <Text className="text-xs text-gray-400 mt-1">
                  Meta: {formatMacro(plan.nutrition.targetCarbs)}
                </Text>
              )}
            </View>

            {/* Gorduras */}
            <View className="flex-1 min-w-[45%] bg-white rounded-2xl border border-gray-200 p-4">
              <View className="flex-row items-center mb-2">
                <View
                  className="w-3 h-3 rounded-full mr-2"
                  style={{ backgroundColor: getMacroColor("fat") }}
                />
                <Text className="text-xs text-gray-600">Gorduras</Text>
              </View>
              <Text className="text-2xl font-bold text-gray-900 mb-1">
                {formatMacro(plan.nutrition.totalFat)}
              </Text>
              <Text className="text-xs text-gray-500">
                {plan.nutrition.fatPercentage.toFixed(0)}% do total calórico
              </Text>
              {plan.nutrition.targetFat && (
                <Text className="text-xs text-gray-400 mt-1">
                  Meta: {formatMacro(plan.nutrition.targetFat)}
                </Text>
              )}
            </View>

            {/* Fibras */}
            <View className="flex-1 min-w-[45%] bg-white rounded-2xl border border-gray-200 p-4">
              <View className="flex-row items-center mb-2">
                <Ionicons name="leaf-outline" size={14} color="#10B981" />
                <Text className="text-xs text-gray-600 ml-1">Fibras</Text>
              </View>
              <Text className="text-2xl font-bold text-gray-900 mb-1">
                {formatMacro(plan.nutrition.totalFiber)}
              </Text>
              {plan.nutrition.targetFiber && (
                <Text className="text-xs text-gray-400 mt-1">
                  Meta: {formatMacro(plan.nutrition.targetFiber)}
                </Text>
              )}
            </View>
          </View>
        </View>

        {/* Gráficos de Macronutrientes */}
        <View className="mx-4 mt-6">
          <MacroNutritionCharts nutrition={plan.nutrition} showTargets={true} />
        </View>

        {/* Shopping List CTA */}
        <TouchableOpacity
          onPress={handleGenerateShoppingList}
          className="bg-green-50 border border-green-200 mx-4 mt-6 p-4 rounded-2xl flex-row items-center justify-between"
        >
          <View className="flex-1 mr-3">
            <Text className="text-base font-semibold text-green-900 mb-1">
              🛒 Lista de Compras
            </Text>
            <Text className="text-sm text-green-700">
              Gere uma lista organizada por categoria
            </Text>
          </View>
          <Ionicons name="chevron-forward" size={24} color="#10B981" />
        </TouchableOpacity>

        {/* Meals List */}
        <View className="mx-4 mt-6 mb-4">
          <Text className="text-base font-semibold text-gray-900 mb-3">
            Refeições ({plan.meals.length})
          </Text>

          {plan.meals.map((meal) => {
            const isExpanded = expandedMeals.has(meal.id);

            return (
              <View
                key={meal.id}
                className="bg-white rounded-2xl border border-gray-200 mb-3 overflow-hidden"
              >
                {/* Meal Header */}
                <TouchableOpacity
                  onPress={() => toggleMealExpansion(meal.id)}
                  className="p-4 flex-row items-center justify-between"
                  style={{
                    backgroundColor: getMealTypeColor(meal.type) + "10",
                  }}
                >
                  <View className="flex-1">
                    <View className="flex-row items-center mb-1">
                      <Text className="text-2xl mr-2">
                        {getMealTypeIcon(meal.type)}
                      </Text>
                      <Text className="text-base font-semibold text-gray-900">
                        {meal.name}
                      </Text>
                    </View>
                    <Text className="text-xs text-gray-500">
                      {meal.time || "Sem horário"} • {meal.items.length}{" "}
                      alimento(s) •{" "}
                      {formatCalories(meal.nutrition.totalCalories)}
                    </Text>
                  </View>
                  <Ionicons
                    name={isExpanded ? "chevron-up" : "chevron-down"}
                    size={24}
                    color="#6B7280"
                  />
                </TouchableOpacity>

                {/* Meal Items (Expanded) */}
                {isExpanded && (
                  <View className="p-4 pt-0">
                    {/* Meal Nutrition Summary */}
                    <View className="bg-gray-50 rounded-xl p-3 mb-3">
                      <Text className="text-xs text-gray-600 mb-2">
                        Resumo Nutricional
                      </Text>
                      <View className="flex-row flex-wrap gap-2">
                        <View className="bg-white px-3 py-1 rounded-full">
                          <Text className="text-xs text-gray-900">
                            🔥 {formatCalories(meal.nutrition.totalCalories)}
                          </Text>
                        </View>
                        <View className="bg-white px-3 py-1 rounded-full">
                          <Text className="text-xs text-gray-900">
                            P: {formatMacro(meal.nutrition.totalProtein)}
                          </Text>
                        </View>
                        <View className="bg-white px-3 py-1 rounded-full">
                          <Text className="text-xs text-gray-900">
                            C: {formatMacro(meal.nutrition.totalCarbs)}
                          </Text>
                        </View>
                        <View className="bg-white px-3 py-1 rounded-full">
                          <Text className="text-xs text-gray-900">
                            G: {formatMacro(meal.nutrition.totalFat)}
                          </Text>
                        </View>
                        <View className="bg-white px-3 py-1 rounded-full">
                          <Text className="text-xs text-gray-900">
                            F: {formatMacro(meal.nutrition.totalFiber)}
                          </Text>
                        </View>
                      </View>
                    </View>

                    {/* Food Items */}
                    {meal.items.map((item, index) => (
                      <View
                        key={index}
                        className={`py-3 ${
                          index < meal.items.length - 1
                            ? "border-b border-gray-100"
                            : ""
                        }`}
                      >
                        <Text className="text-sm font-medium text-gray-900 mb-1">
                          {item.name}
                        </Text>
                        <Text className="text-xs text-gray-500 mb-1">
                          {formatGrams(item.quantity)} • {item.category}
                        </Text>
                        <Text className="text-xs text-gray-400">
                          {formatCalories(item.calories)} • P:{" "}
                          {formatMacro(item.protein)} • C:{" "}
                          {formatMacro(item.carbs)} • G: {formatMacro(item.fat)}
                        </Text>
                        {item.observation && (
                          <Text className="text-xs text-gray-500 italic mt-1">
                            💬 {item.observation}
                          </Text>
                        )}
                      </View>
                    ))}
                  </View>
                )}
              </View>
            );
          })}
        </View>

        {/* Notes */}
        {plan.notes && (
          <View className="mx-4 mb-4">
            <Text className="text-base font-semibold text-gray-900 mb-2">
              Observações Privadas
            </Text>
            <View className="bg-amber-50 border border-amber-200 rounded-2xl p-4">
              <Text className="text-sm text-gray-700">{plan.notes}</Text>
            </View>
          </View>
        )}

        {/* Metadata */}
        <View className="mx-4 mb-6">
          <Text className="text-xs text-gray-400">
            Criado em: {formatShortDate(plan.createdAt)}
          </Text>
          <Text className="text-xs text-gray-400">
            Atualizado em: {formatShortDate(plan.updatedAt)}
          </Text>
        </View>

        <View className="h-8" />
      </ScrollView>
    </SafeAreaView>
  );
}
