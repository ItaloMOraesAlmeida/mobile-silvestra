# .easignore - Otimiza uploads para EAS Build
# Arquivos e pastas que NÃO serão enviados ao EAS Build

# Documentação
*.md
docs/
documentation/

# Testes
__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
test/
tests/
coverage/

# Git
.git/
.gitignore
.gitattributes

#Github
.github/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Arquivos de configuração local
.env
.env*.local
.env.development
.env.preview
.env.homolog
.env.production
.env.example

# Secrets
secrets/
*.secret
*.secret.*
*.pem
*.p12
*.p8
*.mobileprovision
*.jks
*.keystore

# Build artifacts
dist/
build/
web-build/
.expo/

# Dependencies (serão reinstaladas no build)
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Temporários
tmp/
temp/
*.tmp

# Scripts de desenvolvimento
scripts/reset-project.js
scripts/dev-*.sh
scripts/test-*.sh

# Lint
eslint*
.env.*